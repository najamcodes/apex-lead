{
  "name": "apexlead",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:server",
    "test": "bun test tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:coverage": "bun test --coverage tests/unit tests/integration",
    "test:e2e": "bun run playwright test",
    "db:migrate": "bun run backend/db/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "build:server": "cd server && bun run build",
    "build:web": "cd web && bun run build",
    "build:electron": "electron-vite build",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@sdk/core": "link:./sdk/core",
    "@sdk/backend": "link:./sdk/backend",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hono/zod-openapi": "^1.5.1",
    "@libsql/sqlite3": "^0.3.1",
    "@sentry/node": "^10.66.0",
    "@xyflow/react": "^12.11.2",
    "axios": "^1.17.0",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "discord.js": "^14.26.4",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "imapflow": "^1.4.0",
    "lighthouse": "^12.8.2",
    "lucide-react": "^1.17.0",
    "mailparser": "^3.9.9",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.10",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "papaparse": "^5.5.3",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "tough-cookie": "^6.0.1",
    "typeorm": "^1.0.0",
    "wappalyzer-core": "^6.10.66",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.19.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/tough-cookie": "^4.0.5",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
