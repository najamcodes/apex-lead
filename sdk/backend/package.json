{
  "name": "@sdk/backend",
  "version": "1.0.0",
  "description": "ApexLead database, collections, pipelines, workflow nodes, and backend runtime SDK",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./db": "./db/index.ts",
    "./db/*": "./db/*",
    "./collections": "./collections/index.ts",
    "./collections/*": "./collections/*",
    "./nodes": "./nodes/index.ts",
    "./nodes/*": "./nodes/*",
    "./pipelines": "./pipelines/index.ts",
    "./pipelines/*": "./pipelines/*",
    "./routes": "./routes/index.ts",
    "./routes/*": "./routes/*",
    "./templates": "./templates/index.ts",
    "./templates/*": "./templates/*",
    "./*": "./*"
  },
  "dependencies": {
    "@sdk/core": "link:../core",
    "typeorm": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2"
  }
}
