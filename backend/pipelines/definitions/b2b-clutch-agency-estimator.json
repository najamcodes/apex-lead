{
  "id": "b2b-clutch-agency-estimator",
  "name": "B2B Clutch Agency & Deal Size Qualification Funnel",
  "description": "Harvests B2B tech and creative agencies from Clutch.co, classifies deal sizes based on minimum project requirements ($10k - $50k+), discovers key contacts, and triggers LinkedIn ABM.",
  "collection": "leads",
  "status": "active",
  "nodes": [
    {
      "id": "scrape",
      "type": "directory_scraper",
      "label": "Scrape Clutch Agencies",
      "enabled": true,
      "position": { "x": 50, "y": 200 },
      "config": {
        "directory": "clutch",
        "category": "Custom Software Development",
        "city": "San Francisco, CA",
        "max_results": 40,
        "simulate": true
      }
    },
    {
      "id": "estimator",
      "type": "cost_estimator",
      "label": "Agency Minimum Deal Classifier",
      "enabled": true,
      "position": { "x": 350, "y": 200 },
      "config": {
        "high_ticket_threshold": 50000,
        "mid_market_threshold": 20000,
        "project_size_field": "min_project_size",
        "trade_multiplier": 1.0,
        "annual_ltv_multiplier": 2.0
      }
    },
    {
      "id": "enricher",
      "type": "waterfall_enricher",
      "label": "Executive Waterfall Contact Discovery",
      "enabled": true,
      "position": { "x": 650, "y": 150 },
      "config": {
        "cascade_depth": 3
      }
    },
    {
      "id": "linkedin-abm",
      "type": "linkedin",
      "label": "LinkedIn Enterprise Outreach",
      "enabled": true,
      "position": { "x": 950, "y": 100 },
      "config": {
        "action": "connection_request",
        "note_template": "Hi {{contact_name}}, impressed by {{business_name}}'s engineering portfolio on Clutch..."
      }
    },
    {
      "id": "crm-sync",
      "type": "crm_upsert",
      "label": "HubSpot Enterprise Pipeline Sync",
      "enabled": true,
      "position": { "x": 1250, "y": 150 },
      "config": {
        "platform": "hubspot",
        "pipeline_stage": "Qualified Enterprise Deal"
      }
    },
    {
      "id": "store-leads",
      "type": "store",
      "label": "Persist Qualified Leads",
      "enabled": true,
      "position": { "x": 1550, "y": 200 },
      "config": {
        "collection": "leads",
        "mode": "upsert"
      }
    }
  ],
  "edges": [
    { "id": "e1", "from": "scrape", "to": "estimator", "mappings": [] },
    { "id": "e2", "from": "estimator", "to": "enricher", "fromPort": "high_ticket", "mappings": [] },
    { "id": "e3", "from": "estimator", "to": "store-leads", "fromPort": "mid_market", "mappings": [] },
    { "id": "e4", "from": "enricher", "to": "linkedin-abm", "mappings": [] },
    { "id": "e5", "from": "linkedin-abm", "to": "crm-sync", "mappings": [] },
    { "id": "e6", "from": "crm-sync", "to": "store-leads", "mappings": [] }
  ],
  "trigger": {
    "type": "manual"
  },
  "version": 1
}
