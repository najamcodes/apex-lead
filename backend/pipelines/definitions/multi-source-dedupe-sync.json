{
  "id": "multi-source-dedupe-sync",
  "name": "Multi-Vendor Lead Deduplication & Cross-Platform Sync",
  "description": "Merges multi-vendor leads, eliminates duplicates by domain/email, and generates standardized records.",
  "collection": "unified_leads",
  "status": "draft",
  "nodes": [
    {
      "id": "http_1",
      "type": "http",
      "label": "Vendor Partner Leads API",
      "enabled": true,
      "position": { "x": 80, "y": 120 },
      "config": {
        "method": "GET",
        "url": "https://api.partnerleadsource.com/v1/prospects",
        "split_array": true
      }
    },
    {
      "id": "csv_1",
      "type": "spreadsheet",
      "label": "Tradeshow Attendee CSV",
      "enabled": true,
      "position": { "x": 80, "y": 280 },
      "config": {
        "mode": "read",
        "collection": "unified_leads"
      }
    },
    {
      "id": "merge_1",
      "type": "merge",
      "label": "Union Record Streams",
      "enabled": true,
      "position": { "x": 340, "y": 200 },
      "config": {}
    },
    {
      "id": "dedupe_1",
      "type": "dedupe",
      "label": "Email & Domain Dedupe",
      "enabled": true,
      "position": { "x": 580, "y": 200 },
      "config": {
        "dedupeField": "email",
        "secondaryField": "domain",
        "caseInsensitive": true
      }
    },
    {
      "id": "format_1",
      "type": "format",
      "label": "Standardize Fields",
      "enabled": true,
      "position": { "x": 820, "y": 200 },
      "config": {
        "titleCaseNames": true,
        "normalizePhones": true,
        "extractDomains": true
      }
    },
    {
      "id": "export_1",
      "type": "export",
      "label": "Export Unified NDJSON",
      "enabled": true,
      "position": { "x": 1060, "y": 200 },
      "config": {
        "format": "ndjson",
        "fileNameTemplate": "clean_leads_{{date}}"
      }
    }
  ],
  "edges": [
    { "id": "e1", "from": "http_1", "to": "merge_1" },
    { "id": "e2", "from": "csv_1", "to": "merge_1" },
    { "id": "e3", "from": "merge_1", "to": "dedupe_1" },
    { "id": "e4", "from": "dedupe_1", "to": "format_1", "fromPort": "unique" },
    { "id": "e5", "from": "format_1", "to": "export_1" }
  ]
}
