{
  "id": "n8n-erp-sync-bridge",
  "name": "n8n Two-Way Enterprise ERP & Billing Synchronization",
  "description": "Executes complex n8n ERP subflows and dispatches HMAC-signed webhooks upon completion.",
  "collection": "billing_events",
  "status": "draft",
  "nodes": [
    {
      "id": "trigger_1",
      "type": "trigger",
      "label": "Closed-Won Deal Event",
      "enabled": true,
      "position": { "x": 80, "y": 200 },
      "config": {
        "type": "webhook",
        "webhook_slug": "deal-closed-won",
        "collection": "billing_events"
      }
    },
    {
      "id": "format_1",
      "type": "format",
      "label": "Format Account Data",
      "enabled": true,
      "position": { "x": 300, "y": 200 },
      "config": {
        "titleCaseNames": true,
        "cleanCompanyNames": true
      }
    },
    {
      "id": "n8n_1",
      "type": "n8n_bridge",
      "label": "n8n NetSuite/ERP Subflow",
      "enabled": true,
      "position": { "x": 540, "y": 200 },
      "config": {
        "webhookUrl": "http://localhost:5678/webhook/netsuite-onboarding",
        "timeoutMs": 15000,
        "mergeResponse": true
      }
    },
    {
      "id": "code_1",
      "type": "code",
      "label": "Validate ERP Response",
      "enabled": true,
      "position": { "x": 780, "y": 200 },
      "config": {
        "code": "const success = Boolean(record.n8n_response && record.n8n_response.customerId)\nreturn { ...record, erp_synced: success, erp_customer_id: record.n8n_response ? record.n8n_response.customerId : null }"
      }
    },
    {
      "id": "webhook_1",
      "type": "webhook_dispatcher",
      "label": "Signed Client Webhook",
      "enabled": true,
      "position": { "x": 1020, "y": 200 },
      "config": {
        "url": "https://app.client.com/webhooks/billing-synced",
        "secret": "client_hmac_secret_2026",
        "retryCount": 3
      }
    },
    {
      "id": "notify_1",
      "type": "notify",
      "label": "Ops Confirmation Alert",
      "enabled": true,
      "position": { "x": 1260, "y": 200 },
      "config": {
        "channel": "discord",
        "body": "✅ ERP Synchronized: Account {{record.companyName}} successfully provisioned in NetSuite."
      }
    }
  ],
  "edges": [
    { "id": "e1", "from": "trigger_1", "to": "format_1" },
    { "id": "e2", "from": "format_1", "to": "n8n_1" },
    { "id": "e3", "from": "n8n_1", "to": "code_1" },
    { "id": "e4", "from": "code_1", "to": "webhook_1" },
    { "id": "e5", "from": "webhook_1", "to": "notify_1" }
  ]
}
