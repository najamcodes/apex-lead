{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "frontend/**/*",
    "electron/window.d.ts",
    "sdk/core/types/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "frontend/*"
      ],
      "@sdk/core": [
        "sdk/core/index.ts"
      ],
      "@sdk/core/*": [
        "sdk/core/*"
      ]
    }
  }
}
