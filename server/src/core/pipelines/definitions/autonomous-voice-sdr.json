{
  "id": "autonomous-voice-sdr",
  "name": "Conversational AI Voice SDR Outbound Qualification Pipeline",
  "description": "Engages inbound/high-intent leads via voice AI agent, parses transcript disposition, and sets calendar appointments.",
  "collection": "leads",
  "status": "draft",
  "nodes": [
    {
      "id": "webhook_1",
      "type": "trigger",
      "label": "Inbound High-Intent Lead",
      "enabled": true,
      "position": { "x": 80, "y": 200 },
      "config": {
        "type": "webhook",
        "webhook_slug": "high-intent-lead",
        "collection": "leads"
      }
    },
    {
      "id": "decision_1",
      "type": "system_one_decision",
      "label": "OpenJev Fast Filter",
      "enabled": true,
      "position": { "x": 320, "y": 200 },
      "config": {
        "mode": "local_onnx",
        "questions": {
          "is_decision_maker": {
            "type": "noul",
            "instructions": "Lead holds budget authority or executive title to purchase software.",
            "threshold": 0.70
          }
        }
      }
    },
    {
      "id": "voice_1",
      "type": "voice_call",
      "label": "AI SDR Outbound Call",
      "enabled": true,
      "position": { "x": 560, "y": 200 },
      "config": {
        "provider": "vapi",
        "assistantId": "asst_voice_sdr_lead_qualifier",
        "phoneField": "phone",
        "firstMessage": "Hi {{record.firstName}}, this is Alex from ApexLead — saw your inquiry and wanted to quickly see if you are exploring lead automation for Q4?"
      }
    },
    {
      "id": "code_1",
      "type": "code",
      "label": "Analyze Call Transcript",
      "enabled": true,
      "position": { "x": 800, "y": 200 },
      "config": {
        "code": "const disposition = record.callDisposition || 'no_answer'\nconst interested = disposition === 'meeting_scheduled' || disposition === 'interested'\nreturn { ...record, call_outcome: disposition, demo_booked: interested, call_duration: record.callDurationSec || 0 }"
      }
    },
    {
      "id": "crm_1",
      "type": "crm_upsert",
      "label": "CRM Activity & Stage Update",
      "enabled": true,
      "position": { "x": 1040, "y": 200 },
      "config": {
        "crm": "hubspot",
        "operation": "upsert_both",
        "dealStage": "AI Demo Scheduled"
      }
    }
  ],
  "edges": [
    { "id": "e1", "from": "webhook_1", "to": "decision_1" },
    { "id": "e2", "from": "decision_1", "to": "voice_1", "fromPort": "approved" },
    { "id": "e3", "from": "voice_1", "to": "code_1" },
    { "id": "e4", "from": "code_1", "to": "crm_1" }
  ]
}
