{
  "id": "yellowpages-local-dominance",
  "name": "YellowPages Local Dominance & Multi-Channel Harvester",
  "description": "Extracts established local businesses from YellowPages, evaluates years in business and BBB rating credentials, verifies DNS/MX deliverability, and distributes leads to CRM and Webhooks.",
  "collection": "leads",
  "status": "active",
  "nodes": [
    {
      "id": "scrape",
      "type": "directory_scraper",
      "label": "Scrape YellowPages Directory",
      "enabled": true,
      "position": { "x": 50, "y": 200 },
      "config": {
        "directory": "yellowpages",
        "category": "HVAC & Air Conditioning",
        "city": "Atlanta, GA",
        "max_results": 50,
        "simulate": true
      }
    },
    {
      "id": "dedupe",
      "type": "dedupe",
      "label": "Deduplicate by Phone & Name",
      "enabled": true,
      "position": { "x": 350, "y": 200 },
      "config": {
        "strategy": "business_name"
      }
    },
    {
      "id": "dns",
      "type": "dns_check",
      "label": "DNS & Deliverability Verification",
      "enabled": true,
      "position": { "x": 650, "y": 200 },
      "config": {
        "field": "email",
        "min_score": 60
      }
    },
    {
      "id": "estimator",
      "type": "cost_estimator",
      "label": "Local Deal Size & LTV Calculator",
      "enabled": true,
      "position": { "x": 950, "y": 150 },
      "config": {
        "high_ticket_threshold": 12000,
        "mid_market_threshold": 4000,
        "project_size_field": "estimated_avg_job_cost"
      }
    },
    {
      "id": "webhook-out",
      "type": "webhook_dispatcher",
      "label": "Dispatch to Inbound Webhook",
      "enabled": true,
      "position": { "x": 1250, "y": 100 },
      "config": {
        "target_url": "https://api.crm-connector.io/v1/inbound-leads",
        "batch_size": 1
      }
    },
    {
      "id": "store-leads",
      "type": "store",
      "label": "Persist Qualified Directory Leads",
      "enabled": true,
      "position": { "x": 1250, "y": 250 },
      "config": {
        "collection": "leads",
        "mode": "upsert"
      }
    }
  ],
  "edges": [
    { "id": "e1", "from": "scrape", "to": "dedupe", "mappings": [] },
    { "id": "e2", "from": "dedupe", "to": "dns", "mappings": [] },
    { "id": "e3", "from": "dns", "to": "estimator", "fromPort": "deliverable", "mappings": [] },
    { "id": "e4", "from": "dns", "to": "store-leads", "fromPort": "risky", "mappings": [] },
    { "id": "e5", "from": "estimator", "to": "webhook-out", "fromPort": "high_ticket", "mappings": [] },
    { "id": "e6", "from": "estimator", "to": "store-leads", "fromPort": "main", "mappings": [] },
    { "id": "e7", "from": "webhook-out", "to": "store-leads", "mappings": [] }
  ],
  "trigger": {
    "type": "manual"
  },
  "version": 1
}
