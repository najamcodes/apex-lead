{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "backend/**/*",
    "shared/types/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["electron-vite/node"]
  }
}
