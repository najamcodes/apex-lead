{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "backend/**/*",
    "sdk/**/*",
    "plugins/**/*",
    "shared/types/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@sdk/core": ["./sdk/core/index.ts"],
      "@sdk/core/*": ["./sdk/core/*"],
      "@sdk/backend": ["./sdk/backend/index.ts"],
      "@sdk/backend/*": ["./sdk/backend/*"]
    },
    "types": ["electron-vite/node"]
  }
}
